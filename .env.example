# ─────────────────────────────────────────────────────────────
# Backend Environment Variables — copy to .env and fill values
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Port 6543 = pooled (runtime queries via Pgbouncer)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Port 5432 = direct (Prisma migrations only)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Security ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# ── App environment ───────────────────────────────────────────
ENVIRONMENT=production
PORT=8080

# ── CORS — Frontend URL (Railway assigns this after deploy) ───
# Set to the Railway URL of your frontend service
FRONTEND_URL=https://your-frontend.up.railway.app

# ── WhatsApp Cloud API (optional) ────────────────────────────
WHATSAPP_VERIFY_TOKEN=my_secure_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Stage 1 (Central Platform WABA) — the shared bot's dialable number, not a secret. Used only to
# build customer-facing wa.me deep links (see app/services/whatsapp_service.py).
WHATSAPP_CENTRAL_NUMBER=
# Meta App Secret — verifies X-Hub-Signature-256 on inbound webhook POSTs (app/api/v1/webhook.py).
# Find it on the Meta App Dashboard: Settings → Basic → App Secret. REQUIRED in production — until
# set, every inbound WhatsApp message is rejected (fails closed, does not crash the app).
WHATSAPP_APP_SECRET=

# ── Supabase Storage (required for image/video uploads) ───────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=

# ── Super Admin ─────────────────────────────────────────────────
# slug of the platform owner's client account
SUPER_ADMIN_SLUG=smar

# ── AI / Email (optional) ──────────────────────────────────────
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SalmanSaaS <noreply@salmansaas.com>

# ── Self-service onboarding webhook secret (optional) ──────────
# ASCII only
ONBOARDING_SECRET=

# ── Higgsfield API (optional — Phase 51 automation) ────────────
# Server-to-server key for the backend to auto-generate cinematic
# scroll-chapter assets for new tenants (distinct from the Higgsfield
# MCP connector used in Claude Code chat sessions — this key comes
# from your Higgsfield account's own API/developer dashboard).
HIGGSFIELD_API_KEY=
