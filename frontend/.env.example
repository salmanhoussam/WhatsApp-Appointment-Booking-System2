# ──────────────────────────────────────────────────────────────
# Frontend Environment Variables — copy to .env and fill values
# Variables MUST start with VITE_ to be exposed to the browser
# ──────────────────────────────────────────────────────────────

# ── Backend API URL — PUBLIC traffic (Railway assigns this after backend deploy) ──
# No trailing slash. Example: https://api.salmansaas.com
VITE_PUBLIC_API_URL=https://your-backend.up.railway.app

# ── Backend API URL — ADMIN traffic (2026-08-28 API domain split) ──
# Everything account/dashboard/super-admin related (login, registration, setup, admin.config.js's
# adminApi, the super-admin panel) goes here instead -- a separate domain from VITE_PUBLIC_API_URL, even
# though both currently route to the same backend deployment. Example: https://dashboard.salmansaas.com
VITE_ADMIN_API_URL=https://your-backend-admin.up.railway.app

# Local development (already the default if unset -- relative path, resolved through the Vite
# dev-server proxy; see vite.config.js):
# VITE_PUBLIC_API_URL=
# VITE_ADMIN_API_URL=
