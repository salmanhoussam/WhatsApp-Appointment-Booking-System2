model DriverConsent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  driverId    String    @map("driver_id") @db.Uuid
  consentType String    @map("consent_type")
  // "gps_tracking" | "data_processing" | "uber_oauth"
  signedAt    DateTime  @default(now()) @map("signed_at") @db.Timestamptz(6)
  signedBy    String    @map("signed_by")
  ipAddress   String?   @map("ip_address")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  driver FleetDriver @relation(fields: [driverId], references: [id])

  @@index([clientId, driverId])
  @@map("driver_consents")
  @@schema("public")
}

// ===================================================
// MOMENTS MODULE - Personal Occasion Pages
// ===================================================

model OccasionCreator {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  phone         String   @unique
  email         String?  @unique
  password_hash String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  pages OccasionPage[]

  @@map("occasion_creators")
  @@schema("public")
}

model OccasionPage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id   String    @db.Uuid
  slug         String    @unique
  // wedding | anniversary | birthday | engagement | graduation | other
  type         String
  title_ar     String
  title_en     String?
  message_ar   String
  message_en   String?
  event_date   DateTime  @db.Timestamptz(6)
  location_ar  String?
  location_en  String?
  cover_image  String?
  // per-type theme color: #d4a853 wedding, #e11d48 anniversary, #8b5cf6 birthday
  theme_color  String    @default("#d4a853")
  max_guests   Int?
  rsvp_enabled Boolean   @default(true)
  is_active    Boolean   @default(true)
  expires_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  creator OccasionCreator @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  rsvps   OccasionRSVP[]

  @@index([creator_id])
  @@index([slug])
  @@map("occasion_pages")
  @@schema("public")
}

model OccasionRSVP {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id     String   @db.Uuid
  guest_name  String
  guest_phone String?
  guest_count Int      @default(1)
  message     String?
  attending   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  page OccasionPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@index([page_id])
  @@map("occasion_rsvps")
  @@schema("public")
}

// -- Security & Audit (ADR-0001: Tenant Status Enforcement, .claudedocs/decisions/0001-*) ---
model SecurityAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp DateTime @default(now()) @map("timestamp") @db.Timestamptz(6)
  eventType String   @map("event_type")
  // tenant_suspended | tenant_expired | authorization_denied | invalid_signature
  // | login_failed | admin_action | policy_violation - extensible, not an enum by design
  clientId  String?  @map("client_id") @db.Uuid
  // Nullable, no cascade delete (onDelete: SetNull below): denial history must
  // outlive the tenant record for investigations (ADR-0001 §10).
  endpoint  String?  @map("endpoint")
  detail    Json?    @map("detail")
  actor     String?  @map("actor")
  // userId / clientId / "system" - who or what triggered the event, when known

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([eventType])
  @@index([timestamp])
  @@map("security_audit_log")
  @@schema("public")
}

// ── Subscription & Plan (ADR-0002 §11, Implementation Contract 02) ───────────
// Design-approved, minimal domain only - see .claudedocs/adr/ADR-0002.md §11
// and .claudedocs/implementation/ADR-0002_IMPLEMENTATION_CONTRACT_02.md.
// Schema-only change (Phase 1): zero application code reads or writes these
// models yet. No behavior change to app/core/tenant.py or any route/service.

model Plan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String   @unique @map("key")
  // "regular" | "pro" | "ultra" today, matching Client.tier's existing values
  name_ar       String   @map("name_ar")
  name_en       String   @map("name_en")
  // Provisional field (§11.0b, Product-vs-Price question still open) - may
  // move to a separate PricingVersion/PriceBook entity in a future slice.
  monthly_price Decimal  @map("monthly_price")
  currency      String   @default("USD") @map("currency")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
  @@schema("public")
}

model Subscription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Owner: Client (Tenant) only, decided in ADR-0002 §11.0a - not
  // Organization/Account (neither exists in this codebase today). If that
  // layer is ever introduced, this is the specific field that would change.
  clientId  String    @map("client_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  // Best-effort proxy during migration (Client.createdAt) for pre-existing
  // tenants, not true history - see Implementation Contract 02 §5.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  status    String    @map("status")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([clientId])
  @@index([planId])
  @@map("subscriptions")
  @@schema("public")
}
