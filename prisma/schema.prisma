// ================================================================================
// RESERVATIONS MODULE -- Generic slot-based reservation (table, appointment, viewing)
// Works across all service types via moduleKey.
// Gated by client_services.serviceKey = "reservations".
//
// moduleKey -> use case:
//   "restaurant"   -> table reservation (metadata: table_label, party_size)
//   "services"     -> appointment booking (metadata: service_name, staff_id)
//   "real_estate"  -> property viewing (metadata: unit_id, guests, viewing_type)
//   "hotel"        -> check-in appointment or room viewing
// ================================================================================

model Reservation {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String @map("client_id") @db.Uuid
  moduleKey String @map("module_key")
  // "restaurant" | "services" | "real_estate" | "hotel" | "clinic"

  customerName  String  @map("customer_name")
  customerPhone String  @map("customer_phone")
  customerEmail String? @map("customer_email")

  reservedAt  DateTime @map("reserved_at") @db.Timestamptz(6)
  durationMin Int      @default(60) @map("duration_min")

  status String @default("pending") @map("status")
  // pending | confirmed | arrived | cancelled | no_show

  notes String? @map("notes")

  // module-specific payload:
  // restaurant  -> { "table_label": "A4", "party_size": 4 }
  // services    -> { "service_name": "haircut", "staff_id": "uuid" }
  // real_estate -> { "unit_id": "uuid", "guests": 2, "viewing_type": "in_person" }
  // clinic      -> { "resource_id": "uuid", "service_id": "uuid" }  (resource_id also mirrored
  //                below as a real FK -- see Reservation Strategy Architecture design doc)
  // barber      -> { "barber_id": "uuid", "service_id": "uuid" }  (barber_id also mirrored below
  //                as a real FK -- second real Reservation Strategy case, built independently of
  //                clinic per Salman's explicit instruction, 2026-07-31: own Barber table, own
  //                resolve/working-hours/conflict-check code in reservation_service.py. See
  //                .claudedocs/evolution/reservation-capability.md for the comparison once done.)
  metadata Json? @map("metadata")

  // Real FK, added for the "clinic" moduleKey's per-resource conflict/working-hours checks --
  // nullable because moduleKeys with no formal Resource row (restaurant's table_label today)
  // never set it. onDelete: SetNull -- deactivating/removing a Resource must never cascade-delete
  // historical Reservation rows.
  resourceId String?   @map("resource_id") @db.Uuid
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  // Real FK for the "barber" moduleKey -- deliberately its OWN column, not a reuse of resourceId,
  // per the same independent-build instruction above. onDelete: SetNull for the same reason.
  barberId String? @map("barber_id") @db.Uuid
  barber   Barber? @relation(fields: [barberId], references: [id], onDelete: SetNull)

  // Real FK, added Phase 3.7C (2026-08-08) alongside the Service model itself -- replaces the old
  // metadata.service_id JSON-only convention as the source of truth going forward (metadata keeps
  // it for backward-compatible reads of pre-3.7C rows). Same nullable + onDelete: SetNull shape as
  // barberId/resourceId -- a Service being deactivated/removed must never cascade-delete historical
  // Reservation rows.
  serviceId String?         @map("service_id") @db.Uuid
  service   CatalogService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, moduleKey, reservedAt])
  @@index([clientId, status])
  @@index([clientId, resourceId, reservedAt])
  @@index([clientId, barberId, reservedAt])
  @@map("reservations")
  @@schema("public")
}

// ================================================================================
// RESOURCES -- per-resource schedule for the Reservation capability (a doctor today;
// a desk/chair/vehicle if a future moduleKey needs one). Single table for v1 (Reservation
// Strategy Architecture design doc, Correction 2, revised 2026-07-30): `type` discriminates
// what the row represents ("doctor" today); resource-type-specific fields beyond
// name/specialty/phone (license_number, bio, salary, ...) are deferred until a real need
// appears, per this project's Abstraction Rule -- do not add them speculatively.
// ================================================================================

model Resource {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  type         String   @map("type")
  // "doctor" today -- freeform string, matching this schema's existing moduleKey/unit_type
  // convention (no rigid enum anywhere else in this file either).
  name         String   @map("name")
  specialty    String?  @map("specialty")
  phone        String?  @map("phone")
  isActive     Boolean  @default(true) @map("is_active")
  // Same shape as Client.config.working_hours: {"closed_days": [...], "open_time": "HH:MM",
  // "close_time": "HH:MM"}. Reservation Strategy's scheduling logic reads this first, falling
  // back to Client.config.working_hours only when null.
  workingHours Json?    @map("working_hours")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([clientId, type])
  @@index([clientId, isActive])
  @@map("resources")
  @@schema("public")
}

// A barbershop's staff calendar -- the 2nd real Reservation Strategy case (2026-07-31).
// Built deliberately independent of Resource/Clinic (Salman's explicit instruction: build as if
// Clinic didn't exist, so a later comparison is honest evidence, not an assumption). Real,
// independent field decisions for this table:
//   - no `type` discriminator: unlike Resource, there is only one kind of thing here (a barber),
//     so a future-proofing type column wasn't justified by any real requirement today.
//   - no `specialty`: nothing in this build needs to filter/search barbers by a skill tag; adding
//     one now would be exactly the kind of speculative field the Metadata Field Test's reasoning
//     argues against, applied here to a real column instead of a metadata key.
// See .claudedocs/evolution/reservation-capability.md for the post-build comparison against
// Resource once both are live-verified.
model Barber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  name         String   @map("name")
  phone        String?  @map("phone")
  // Phase 3.7A (2026-08-07) -- added alongside the first real Staff CRUD UI, additive only, no
  // existing field touched. imageUrl follows the same plain-URL-field pattern as
  // Client.primary_color-adjacent branding fields, not a GalleryImage relation -- a barber has
  // exactly one photo, not a gallery.
  imageUrl     String?  @map("image_url")
  description  String?  @map("description")
  isActive     Boolean  @default(true) @map("is_active")
  // Same shape as Client.config.working_hours / Resource.workingHours: {"closed_days": [...],
  // "open_time": "HH:MM", "close_time": "HH:MM"} -- independently arrived at the same shape
  // because it's the one shape reservation_service.py's _check_working_hours() (pre-existing,
  // domain-agnostic utility) understands; not copied from Resource's own field.
  workingHours Json?    @map("working_hours")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  barberServices BarberService[]
  // Staff Scoped Access, Phase A (2026-08-09) -- opposite side of User.barberId, not a list: at
  // most one login account per Barber.
  user           User?

  @@index([clientId, isActive])
  @@map("barbers")
  @@schema("public")
}

// ================================================================================
// BARBER SERVICE -- which CatalogServices a Barber is qualified to perform. Phase 3.7C
// (2026-08-08), the actual Staff<->Service relationship the Capability Investigation named.
// Mirrors ClientService's already-proven bridge-table shape (schema.prisma:473-487) -- a plain
// many-to-many, not a new pattern. onDelete: Cascade both sides (unlike Reservation's FKs, which
// use SetNull to preserve historical rows) -- this table only records a *current* qualification
// fact; if either side is hard-deleted there's nothing left for the assignment to mean.
// ================================================================================

model BarberService {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  barber  Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service CatalogService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@index([clientId])
  @@map("barber_services")
  @@schema("public")
}

// ================================================================================
