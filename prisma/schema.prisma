// ================================================================================
// FLEET MODULE (Phase 76 - Vicale Fleet Platform)
// Manages vehicles + drivers for Uber fleet operators.
// Data sources: Samsara (GPS / safety webhooks) + Uber (CSV import -> FleetTrip).
// Gated by client_services.serviceKey = "fleet".
// DSGVO note: GPS data = personenbezogene Daten - consent required per driver.
// ================================================================================

model FleetVehicle {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  samsaraId     String?   @unique @map("samsara_id")
  uberVehicleId String?   @map("uber_vehicle_id")
  plateNumber   String    @map("plate_number")
  make          String?
  model         String?
  year          Int?
  status        String    @default("active") @map("status")
  // active | idle | maintenance | offline
  lastLat       Float?    @map("last_lat")
  lastLng       Float?    @map("last_lng")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  driver        FleetDriver?
  trips         FleetTrip[]
  samsaraEvents SamsaraEvent[]

  @@index([clientId])
  @@index([clientId, status])
  @@map("fleet_vehicles")
  @@schema("public")
}

model FleetDriver {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  vehicleId     String?  @unique @map("vehicle_id") @db.Uuid
  samsaraId     String?  @map("samsara_id")
  uberDriverId  String?  @map("uber_driver_id")
  name          String
  phone         String?
  safetyScore   Float?   @map("safety_score")
  totalTrips    Int      @default(0) @map("total_trips")
  totalEarnings Float    @default(0) @map("total_earnings")
  uberToken     String?  @map("uber_token")
  // encrypted OAuth token - Phase 2
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle  FleetVehicle?   @relation(fields: [vehicleId], references: [id])
  trips    FleetTrip[]
  alerts   DriverAlert[]
  consents DriverConsent[]

  @@index([clientId])
  @@map("fleet_drivers")
  @@schema("public")
}

model FleetTrip {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  driverId    String?   @map("driver_id") @db.Uuid
  uberTripRef String?   @unique @map("uber_trip_ref")
  startTime   DateTime  @map("start_time") @db.Timestamptz(6)
  endTime     DateTime? @map("end_time") @db.Timestamptz(6)
  revenue     Float?
  distanceKm  Float?    @map("distance_km")
  city        String?
  status      String    @default("completed") @map("status")
  // started | completed | cancelled
  source      String    @default("csv") @map("source")
  // csv | api | manual
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle FleetVehicle @relation(fields: [vehicleId], references: [id])
  driver  FleetDriver? @relation(fields: [driverId], references: [id])

  @@index([clientId, startTime])
  @@index([clientId, vehicleId])
  @@map("fleet_trips")
  @@schema("public")
}

model SamsaraEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  vehicleId  String?  @map("vehicle_id") @db.Uuid
  eventType  String   @map("event_type")
  // SpeedingEventStarted | SevereSpeedingEnded | GeofenceEntry | GeofenceExit
  // AlertIncident | EngineOn | EngineOff | DriverCreated | DriverUpdated
  severity   String? // low | medium | high
  lat        Float?
  lng        Float?
  speed      Float?
  rawPayload Json     @map("raw_payload")
  isRead     Boolean  @default(false) @map("is_read")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle FleetVehicle? @relation(fields: [vehicleId], references: [id])

  @@index([clientId, eventType])
  @@index([clientId, occurredAt])
  @@map("samsara_events")
  @@schema("public")
}

model DriverAlert {
